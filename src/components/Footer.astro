---
import site from '../data/site.json';
---
<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="eyebrow">Find us</p>
      <p>{site.address}</p>
    </div>
    <div>
      <p class="eyebrow">Get in touch</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
    </div>
    <div>
      <p class="eyebrow">Follow us</p>
      <p>
        <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">Instagram</a> ·
        <a href={`https://facebook.com/${site.facebook}`} target="_blank" rel="noopener">Facebook</a><br />
        <a href={site.mailchimp} target="_blank" rel="noopener">Sign up for takeaway reminders</a>
      </p>
    </div>
  </div>
</footer>
<style>
  .site-footer { position: relative; z-index: 1; margin-top: 6rem; padding: 3rem 0; background: var(--darkred); color: var(--pink); font-size: .95rem; }
  .grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  p { margin: 0 0 .4rem; }
  .eyebrow { color: var(--brightyellow); }
</style>
