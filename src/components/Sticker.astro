---
// The playful "sticker" buttons from the live site. The old site drew the words as
// vector outlines; here they are real text so they're easy to edit and readable by screen readers.
import Burst from '../assets/svg/burst-292.svg?raw';
type Kind = 'takeaway' | 'lunch' | 'about' | 'food';
interface Props { kind: Kind; href?: string; size?: string; tilt?: number; class?: string; heading?: boolean }
const { kind, href, size = '12rem', tilt, class: cls = '', heading = false } = Astro.props;
const labels: Record<Kind, string> = {
  takeaway: 'Order Takeaway', lunch: 'Community Lunch', about: 'About Us', food: 'About the Food',
};
const defaultTilt: Record<Kind, number> = { takeaway: 0, lunch: -12, about: -14, food: -16 };
const Tag = href ? 'a' : heading ? 'h1' : 'div';
const id = `arc-${Math.random().toString(36).slice(2, 8)}`;
---
<Tag href={href} class:list={['sticker', kind, cls]} style={`--size:${size};--tilt:${tilt ?? defaultTilt[kind]}deg`}>
  {kind === 'takeaway' ? (
    <span class="burst-wrap">
      <span class="burst spin-slow" set:html={Burst} />
      <svg class="arc" viewBox="0 0 200 200" aria-hidden="true">
        <defs><path id={id} d="M 100 100 m -64 0 a 64 64 0 1 1 128 0 a 64 64 0 1 1 -128 0" /></defs>
        <text><textPath href={`#${id}`} startOffset="25%" text-anchor="middle">{labels[kind]}</textPath></text>
      </svg>
      <span class="visually-hidden">{labels[kind]}</span>
    </span>
  ) : (
    <span class="label">{kind === 'lunch' ? <>Community<br />Lunch</> : kind === 'food' ? <>About<br />the Food</> : labels[kind]}</span>
  )}
</Tag>
<style>
  .sticker { display: inline-block; text-decoration: none; transform: rotate(var(--tilt)); transition: transform .4s var(--ease-out); font-weight: 700; letter-spacing: -0.01em; margin: 0; }
  a.sticker:hover, a.sticker:focus-visible { transform: rotate(calc(var(--tilt) + 6deg)) translateX(-4px) scale(1.04); }
  a.sticker:active { transform: rotate(var(--tilt)) scale(.97); }

  .burst-wrap { position: relative; display: block; width: var(--size); aspect-ratio: 1; }
  .burst, .burst :global(svg), .arc { position: absolute; inset: 0; width: 100%; height: 100%; }
  .arc text { fill: var(--darkred); font-size: 22px; font-weight: 700; font-family: var(--font); }

  .label { display: block; text-align: center; line-height: 1.05; font-size: calc(var(--size) / 7.5); }
  .lunch .label { background: var(--red); color: var(--brightyellow); padding: .6em 1em; box-shadow: .25em .25em 0 var(--brightyellow); }
  .food .label { background: var(--red); color: var(--brightyellow); padding: .7em 1.1em; }
  .about .label { background: var(--pink); color: var(--red); padding: .35em .9em; border-radius: 999px; }
</style>
