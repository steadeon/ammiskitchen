---
// FAQ list. Native <details> so it works without JavaScript; the smooth open/close
// uses modern CSS where the browser supports it.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
const colours = ['bg-darkred', 'bg-red', 'bg-orange', 'bg-yellow', 'bg-pink'];
---
<div class="accordion">
  {items.map((item, i) => (
    <details class:list={['item', colours[i % colours.length]]} data-reveal>
      <summary>{item.q}<span class="icon" aria-hidden="true">+</span></summary>
      <div class="answer" set:html={item.a} />
    </details>
  ))}
</div>
<style>
  .accordion { display: grid; gap: .5rem; }
  .item { border-radius: var(--radius); padding: 1rem 1.5rem; interpolate-size: allow-keywords; }
  .item.bg-yellow, .item.bg-pink { color: var(--darkred); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1rem; font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 500; letter-spacing: -0.025em; }
  summary::-webkit-details-marker { display: none; }
  .icon { font-size: 1.5rem; line-height: 1; transition: transform .5s var(--ease-out); }
  details[open] .icon { transform: rotate(45deg); }
  .item::details-content { block-size: 0; overflow: hidden; transition: block-size 1s var(--ease-out), content-visibility 1s allow-discrete; }
  .item[open]::details-content { block-size: auto; }
  .answer { max-width: 34rem; padding-top: .5rem; font-size: 1rem; line-height: 1.35; }
  .answer :global(p) { margin: 0 0 .5rem; }
  .answer :global(ul), .answer :global(ol) { margin: 0 0 .5rem; padding-left: 1.25rem; }
</style>
