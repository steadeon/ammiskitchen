---
// The takeaway order form. No accounts: customers type their details each time.
// Orders go to the Worker at /api/order (worker/index.ts), which checks the deadline again,
// saves the order in Sanity and sends the emails. The form closes itself at the deadline.
// "Pay now" (a beta feature, see src/lib/features.ts) appears only when the Worker says this visitor
// can pay online: then PayPal's buttons replace "Send my order" (see worker/paypal.ts for the flow).
import { formatDay, formatDeadline, isOpen } from '../lib/ordering';
import type { Order, Site } from '../lib/cms';

interface Props { order: { schedule: Order['schedule']; options: Order['options'] }; site: Site }
const { order, site } = Astro.props;
const { schedule, options } = order;
const day = schedule.takeawayDate ? formatDay(schedule.takeawayDate) : '';
const deadline = schedule.cutoff ? formatDeadline(schedule.cutoff) : '';
const openAtBuild = isOpen(schedule);
const collection = options.filter((o) => o.method === 'collection');
const delivery = options.filter((o) => o.method === 'delivery');
const methods = [
  { value: 'collection', title: 'Collect', text: site.address ? `From ${site.address}` : 'From the community centre', opts: collection },
  { value: 'delivery', title: 'Delivery', text: 'Brought to your door on Friday afternoon', opts: delivery },
].filter((m) => m.opts.length);
const paypal = options.filter((o) => o.url);
const contact = [site.phone && `call ${site.phone}`, site.email && `email ${site.email}`].filter(Boolean).join(' or ');
---
<section class="order" id="order" data-order-form data-cutoff={schedule.cutoff} data-closed-text={deadline}>
  <div class="card bg-yellow order-card">
    <div class="head">
      <h2>Place your order</h2>
      {day && <p class="for">for <strong>{day}</strong></p>}
    </div>

    <div data-panel="open" hidden={!openAtBuild}>
      <p class="lede">No account needed. <span data-pay-lede>You pay by cash or card when you {methods.length > 1 ? 'collect or we deliver' : methods[0]?.value === 'delivery' ? 'receive your delivery' : 'collect'}.</span>
        {deadline && <>{' '}Orders close <strong>{deadline}</strong>.</>}</p>

      <form novalidate>
        <fieldset class="methods">
          <legend class="step">1. Collection or delivery?</legend>
          <div class="method-grid">
            {methods.map((m, i) => (
              <label class="method">
                <input type="radio" name="method" value={m.value} checked={i === 0} required />
                <span class="method-title">{m.title}</span>
                <span class="method-text">{m.text}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="step">2. How many meals?</legend>
          <p class="error" data-error="items" hidden></p>
          {methods.map((m, i) => (
            <div class="options" data-method={m.value} hidden={i !== 0}>
              {m.opts.map((o) => (
                <div class="option">
                  <div>
                    <h3>{o.type}</h3>
                    <p class="price">£{o.price.toFixed(2)} <span>each</span></p>
                    {o.description && <p class="desc">{o.description}</p>}
                  </div>
                  <div class="stepper" role="group" aria-label={`Number of ${o.type} meals`}>
                    <button type="button" data-step="-1" aria-label="One fewer">−</button>
                    <input type="number" name={`qty-${o.key}`} value="0" min="0" max="50" inputmode="numeric" data-price={o.price} aria-label={`${o.type} quantity`} />
                    <button type="button" data-step="1" aria-label="One more">+</button>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </fieldset>

        <fieldset class="details">
          <legend class="step">3. Your details</legend>
          <label>Your name<input name="name" autocomplete="name" required maxlength="100" /><span class="error" data-error="name" hidden></span></label>
          <label>Phone number<input name="phone" type="tel" autocomplete="tel" required maxlength="30" /><span class="error" data-error="phone" hidden></span></label>
          <label class="wide"><span>Email <span class="hint">(optional, for a confirmation email)</span></span><input name="email" type="email" autocomplete="email" maxlength="200" /><span class="error" data-error="email" hidden></span></label>
          <div class="wide delivery-only" hidden>
            <label>Delivery address<textarea name="address" rows="3" autocomplete="street-address" maxlength="400"></textarea><span class="error" data-error="address" hidden></span></label>
            <label class="postcode">Postcode<input name="postcode" autocomplete="postal-code" maxlength="10" /><span class="error" data-error="postcode" hidden></span></label>
          </div>
          <label class="wide"><span>Anything we should know? <span class="hint">(optional: allergies, access, etc.)</span></span><textarea name="notes" rows="3" maxlength="1000"></textarea></label>
          <label class="trap" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        </fieldset>

        <fieldset class="pay" data-pay hidden>
          <legend class="step">4. How would you like to pay?</legend>
          <p class="error" data-error="payment" hidden></p>
          <div class="method-grid">
            <label class="method">
              <input type="radio" name="payment" value="paypal" checked disabled />
              <span class="method-title">Pay now</span>
              <span class="method-text">With PayPal, or by debit or credit card (no PayPal account needed)</span>
            </label>
            <label class="method">
              <input type="radio" name="payment" value="later" disabled />
              <span class="method-title" data-later-title>Pay when you collect</span>
              <span class="method-text">By cash or card, as usual</span>
            </label>
          </div>
          <p class="sandbox" data-sandbox hidden>Test mode: payments use PayPal's sandbox, so no real money is taken.</p>
        </fieldset>

        <div class="turnstile" data-turnstile></div>

        <div class="submit">
          <p class="total" aria-live="polite"><strong data-total-meals>0 meals</strong> · <span data-total-price>£0.00</span> to pay <span data-pay-when>on collection</span></p>
          <button class="send" type="submit">Send my order</button>
        </div>
        <div class="paypal-buttons" data-paypal-buttons hidden></div>
        <p class="error form-error" data-error="form" role="alert" hidden></p>

        <p class="privacy">
          <strong>Your details:</strong> we only use them to make, deliver and contact you about this order. They're stored securely,
          seen only by our team, never shared or used for marketing, and deleted about three months after your takeaway.
          {contact && <>{' '}To see, change or delete them, {contact}.</>}
        </p>
      </form>

      {paypal.length > 0 && (
        <p class="paypal" data-paypal-links>Prefer to pay in advance? {paypal.map((o, i) => <>{i > 0 && ' · '}<a href={o.url} target="_blank" rel="noopener">{o.type} (PayPal)</a></>)}. Please still send this form so we know your order.</p>
      )}
    </div>

    <div data-panel="closed" hidden={openAtBuild} class="closed">
      <p class="big">Online orders are closed.</p>
      <p>{deadline ? <>Orders for {day} closed on <span data-deadline>{deadline}</span>. </> : ''}Look out for the next menu soon{site.mailchimp && <>, or <a href={site.mailchimp} target="_blank" rel="noopener">sign up for takeaway reminders</a></>}.</p>
      {contact && <p>Missed the deadline? {contact[0].toUpperCase() + contact.slice(1)} and we'll help if we can.</p>}
    </div>

    <div data-panel="done" hidden class="done" tabindex="-1">
      <p class="big">Thank you, your order is in!</p>
      <p>Your order number is <strong class="ref" data-ref></strong>. <span data-done-summary></span></p>
      <p data-done-email></p>
      {contact && <p>Need to change or cancel? Please {contact} and quote your order number.</p>}
    </div>
  </div>
</section>

<script>
  type Status = { open: boolean; cutoff: string; siteKey: string; payOnline: { clientId: string; mode: 'sandbox' | 'live' } | null };
  declare global { interface Window { turnstile?: any; paypal?: any } }

  const money = (n: number) => `£${n.toFixed(2)}`;

  function loadTurnstile(): Promise<any> {
    if (window.turnstile) return Promise.resolve(window.turnstile);
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve(window.turnstile);
      s.onerror = reject;
      document.head.append(s);
    });
  }

  function loadPayPal(clientId: string): Promise<any> {
    if (window.paypal) return Promise.resolve(window.paypal);
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      // Pay Later is switched off: PayPal charges the charity more for it.
      s.src = `https://www.paypal.com/sdk/js?${new URLSearchParams({ 'client-id': clientId, currency: 'GBP', intent: 'capture', components: 'buttons', 'disable-funding': 'paylater,credit' })}`;
      s.async = true;
      s.dataset.namespace = 'paypal';
      s.onload = () => resolve(window.paypal);
      s.onerror = reject;
      document.head.append(s);
    });
  }

  const post = async (url: string, body: unknown) => {
    const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    return res.json().catch(() => ({ ok: false, error: 'Sorry, something went wrong. Please try again.' }));
  };

  function init() {
    const root = document.querySelector<HTMLElement>('[data-order-form]');
    if (!root || root.dataset.ready) return;
    // Still a beta feature and this visitor hasn't turned it on: the form is hidden, so do nothing.
    const gate = root.closest<HTMLElement>('[data-beta-only]')?.dataset.betaOnly;
    if (gate && !(document.documentElement.dataset.beta ?? '').split(' ').includes(gate)) return;
    root.dataset.ready = '1';
    const form = root.querySelector('form')!;
    const panel = (name: string) => root.querySelector<HTMLElement>(`[data-panel="${name}"]`)!;
    const show = (name: string) => ['open', 'closed', 'done'].forEach((p) => (panel(p).hidden = p !== name));
    let cutoff = root.dataset.cutoff ? new Date(root.dataset.cutoff).getTime() : 0;
    let widget: string | undefined;
    let canPayOnline = false;

    // Close the form by itself at the deadline (and if the page was opened after it).
    const checkClosed = () => {
      if (!panel('done').hidden) return;
      if (!cutoff || Date.now() >= cutoff) show('closed');
    };
    checkClosed();
    const timer = setInterval(checkClosed, 30_000);
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true });

    // Ask the server for the latest status (in case staff changed the date) and the spam-check key.
    fetch('/api/order', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then(async (s: Status) => {
        cutoff = s.cutoff ? new Date(s.cutoff).getTime() : 0;
        // Keep the "closed on …" wording in step with the server if staff changed the deadline since the last build.
        const shown = root.querySelector('[data-deadline]');
        if (shown && s.cutoff) shown.textContent = new Date(s.cutoff).toLocaleString('en-GB', { timeZone: 'Europe/London', weekday: 'long', day: 'numeric', month: 'long', hour: 'numeric', minute: '2-digit', hour12: true }).replace(' at', ',');
        if (!panel('done').hidden) return;
        if (!s.open) return show('closed');
        show('open');
        checkClosed();
        const ts = await loadTurnstile();
        widget = ts.render(root.querySelector('[data-turnstile]'), { sitekey: s.siteKey, theme: 'light', size: 'flexible' });
        if (s.payOnline) await enablePayOnline(s.payOnline);
      })
      .catch(() => { /* Order service unreachable (e.g. local dev): keep the build-time state. */ });

    // Collection / delivery switch.
    const method = () => (form.querySelector<HTMLInputElement>('input[name="method"]:checked')?.value ?? 'collection');
    const payNow = () => canPayOnline && form.querySelector<HTMLInputElement>('input[name="payment"]:checked')?.value === 'paypal';
    const sendButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const paypalButtons = form.querySelector<HTMLElement>('[data-paypal-buttons]')!;
    const update = () => {
      const m = method();
      form.querySelectorAll<HTMLElement>('[data-method]').forEach((el) => (el.hidden = el.dataset.method !== m));
      form.querySelector<HTMLElement>('.delivery-only')!.hidden = m !== 'delivery';
      let meals = 0, price = 0;
      form.querySelectorAll<HTMLInputElement>(`[data-method="${m}"] input[type="number"]`).forEach((i) => {
        const n = Math.max(0, Math.min(50, Math.floor(Number(i.value) || 0)));
        meals += n; price += n * Number(i.dataset.price);
      });
      form.querySelector('[data-total-meals]')!.textContent = `${meals} meal${meals === 1 ? '' : 's'}`;
      form.querySelector('[data-total-price]')!.textContent = money(price);
      form.querySelector('[data-pay-when]')!.textContent = payNow() ? 'now, online' : m === 'delivery' ? 'on delivery' : 'on collection';
      form.querySelector('[data-later-title]')!.textContent = m === 'delivery' ? 'Pay on delivery' : 'Pay when you collect';
      // Paying now: PayPal's buttons take the place of "Send my order".
      sendButton.hidden = payNow();
      paypalButtons.hidden = !payNow();
    };
    form.addEventListener('change', update);
    form.addEventListener('input', update);
    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        const input = b.parentElement!.querySelector('input')!;
        input.value = String(Math.max(0, Math.min(50, (Number(input.value) || 0) + Number(b.dataset.step))));
        update();
      }),
    );
    update();

    const setErrors = (fields: Record<string, string> = {}, message = '') => {
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
        const msg = el.dataset.error === 'form' ? message : fields[el.dataset.error!];
        el.textContent = msg ?? '';
        el.hidden = !msg;
        const input = el.parentElement?.querySelector('input, textarea');
        if (input && el.dataset.error !== 'form' && el.dataset.error !== 'items') input.setAttribute('aria-invalid', String(Boolean(msg)));
      });
    };

    // The form's answers, with quantities only for the chosen method.
    const collect = () => {
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const m = method();
      for (const k of Object.keys(data)) if (k.startsWith('qty-') && !form.querySelector(`[data-method="${m}"] [name="${k}"]`)) delete data[k];
      return data;
    };

    const showDone = (out: any, email: string, paid: boolean) => {
      const m = method();
      root.querySelector('[data-ref]')!.textContent = out.reference;
      root.querySelector('[data-done-summary]')!.textContent = paid
        ? `${out.totalMeals} meal${out.totalMeals === 1 ? '' : 's'} for ${out.day}. You've paid ${out.total} online, so there's nothing to pay ${m === 'delivery' ? 'on delivery' : 'when you collect'}.`
        : `${out.totalMeals} meal${out.totalMeals === 1 ? '' : 's'} for ${out.day}, ${out.total} to pay ${m === 'delivery' ? 'on delivery' : 'when you collect'}.`;
      root.querySelector('[data-done-email]')!.textContent = out.emailed ? `We've emailed a confirmation to ${email}.` : '';
      show('done');
      panel('done').focus();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // A refused order: field problems show beside the field; the message by the button is for anything else.
    const showProblem = (out: any) => {
      if (out.closed) { cutoff = 1; show('closed'); return; }
      setErrors(out.fields, out.fields && Object.keys(out.fields).length ? 'Please check the highlighted details above.' : out.error);
      (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
    };

    // Quick checks before PayPal's pop-up opens, so customers don't pay into a form with gaps.
    // The Worker checks everything again properly.
    const quickCheck = () => {
      const data = collect();
      const fields: Record<string, string> = {};
      if (!Object.entries(data).some(([k, v]) => k.startsWith('qty-') && Number(v) > 0)) fields.items = 'Please choose how many meals you would like.';
      if (!data.name?.trim()) fields.name = 'Please tell us your name.';
      if ((data.phone?.match(/\d/g)?.length ?? 0) < 7) fields.phone = 'Please give a phone number we can call.';
      if (method() === 'delivery') {
        if (!data.address?.trim()) fields.address = 'Please give the delivery address.';
        if (!data.postcode?.trim()) fields.postcode = 'Please give a full postcode, like S7 1FB.';
      }
      if (widget !== undefined && !data['cf-turnstile-response']) return { fields, message: "Please tick the \"I'm not a robot\" check box first." };
      return Object.keys(fields).length ? { fields, message: 'Please check the highlighted details above.' } : null;
    };

    async function enablePayOnline(pay: NonNullable<Status['payOnline']>) {
      let pp: any;
      try {
        pp = await loadPayPal(pay.clientId);
      } catch {
        return; // PayPal unreachable: customers can still pay on collection, as before.
      }
      const fieldset = form.querySelector<HTMLElement>('[data-pay]')!;
      fieldset.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.disabled = false));
      fieldset.hidden = false;
      form.querySelector<HTMLElement>('[data-sandbox]')!.hidden = pay.mode !== 'sandbox';
      const links = root.querySelector<HTMLElement>('[data-paypal-links]');
      if (links) links.hidden = true;
      root.querySelector('[data-pay-lede]')!.textContent = 'Pay online now, or by cash or card when you get your food.';
      canPayOnline = true;
      let email = '';
      let refused = false;
      await pp
        .Buttons({
          style: { layout: 'vertical', shape: 'pill', label: 'pay', height: 48 },
          onClick: (_data: unknown, actions: any) => {
            checkClosed();
            const problem = panel('closed').hidden ? quickCheck() : { fields: {}, message: '' };
            setErrors(problem?.fields, problem?.message);
            if (problem) {
              (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
              return actions.reject();
            }
            return actions.resolve();
          },
          // Saves the order (unpaid) and starts a PayPal payment for the price the Worker works out.
          createOrder: async () => {
            refused = false;
            const data = collect();
            email = data.email ?? '';
            try {
              const out = await post('/api/order', data);
              if (!out.ok || !out.paypalOrderId) {
                refused = true;
                showProblem(out);
                throw new Error('Order refused');
              }
              return out.paypalOrderId;
            } finally {
              if (widget !== undefined) window.turnstile?.reset(widget);
            }
          },
          // The customer paid in PayPal's pop-up: ask the Worker to take the money and confirm the order.
          onApprove: async (data: { orderID: string }, actions: any) => {
            paypalButtons.classList.add('busy');
            try {
              const out = await post('/api/order/pay', { paypalOrderId: data.orderID });
              if (out.retry) return actions.restart();
              if (out.ok) return showDone(out, email, out.paid);
              setErrors({}, out.error);
            } catch {
              setErrors({}, "We couldn't reach our server to confirm your payment. Please don't pay again: contact us and we'll check.");
            } finally {
              paypalButtons.classList.remove('busy');
            }
          },
          onCancel: () => setErrors({}, "Payment cancelled, so your order hasn't been sent. You can try again, or choose to pay when you get your food."),
          onError: () => {
            if (!refused) setErrors({}, "Sorry, the payment didn't go through and your order hasn't been sent. Please try again, or choose to pay when you get your food.");
          },
        })
        .render(paypalButtons)
        .catch(() => {
          // Buttons couldn't load: fall back to paying on collection.
          canPayOnline = false;
          fieldset.hidden = true;
        });
      update();
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      checkClosed();
      if (!panel('closed').hidden) return;
      // Pressing Enter while "Pay now" is chosen: point to PayPal's buttons instead.
      if (payNow()) { setErrors({}, 'Please use the payment buttons below to pay and send your order.'); return; }
      const button = sendButton;
      const data = collect();
      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const out = await post('/api/order', data);
        if (out.ok) return showDone(out, data.email, false);
        showProblem(out);
      } catch {
        setErrors({}, "We couldn't reach our server. Please check your connection and try again.");
      } finally {
        button.disabled = false;
        button.textContent = 'Send my order';
        if (widget !== undefined) window.turnstile?.reset(widget);
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .order { scroll-margin-top: 2rem; }
  .order-card { max-width: 56rem; margin-inline: auto; padding: clamp(1.5rem, 4vw, 3rem); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; }
  .head h2 { font-size: clamp(2rem, 5vw, 3rem); }
  .for { margin: 0; font-size: 1.2rem; }
  .lede { font-size: 1.1rem; max-width: 40rem; }
  form { margin-top: 1.5rem; display: grid; gap: 2rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .step { font-weight: 700; font-size: 1.25rem; margin-bottom: .75rem; padding: 0; }

  .method-grid { display: grid; gap: .75rem; }
  @media (min-width: 640px) { .method-grid { grid-template-columns: 1fr 1fr; } }
  .method { position: relative; display: grid; gap: .2rem; padding: 1rem 1.25rem 1rem 3.25rem; border-radius: 1.25rem; background: var(--white); cursor: pointer; border: 3px solid transparent; transition: border-color .2s, transform .3s var(--ease-out); }
  .method:hover { transform: translateY(-2px); }
  .method:has(input:checked) { border-color: var(--darkred); }
  .method input { position: absolute; left: 1.1rem; top: 1.15rem; width: 1.3rem; height: 1.3rem; accent-color: var(--darkred); margin: 0; }
  .method-title { font-weight: 700; font-size: 1.2rem; }
  .method-text { font-size: .9rem; }

  .options { display: grid; gap: .75rem; }
  .options[hidden] { display: none; }
  .option { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; background: var(--orange); color: var(--white); border-radius: 1.25rem; padding: 1.1rem 1.25rem; }
  .option > div:first-child { flex: 1 1 16rem; }
  .option h3 { font-size: 1.3rem; font-weight: 600; }
  .option .price { margin: .2rem 0 0; font-size: 1.3rem; font-weight: 600; }
  .option .price span { font-size: .85rem; font-weight: 400; }
  .option .desc { margin: .35rem 0 0; font-size: .9rem; }
  .stepper { display: flex; align-items: center; background: var(--white); border-radius: 999px; padding: .25rem; }
  .stepper button { width: 2.6rem; height: 2.6rem; border-radius: 50%; border: 0; background: var(--darkred); color: var(--white); font-size: 1.4rem; line-height: 1; cursor: pointer; font-family: inherit; }
  .stepper button:hover { background: var(--red); }
  .stepper input { width: 3rem; text-align: center; border: 0; font: 600 1.3rem var(--font); color: var(--darkred); background: transparent; -moz-appearance: textfield; }
  .stepper input::-webkit-inner-spin-button, .stepper input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  .details { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .details { grid-template-columns: 1fr 1fr; } .details .step, .wide { grid-column: 1 / -1; } }
  .details label { display: grid; gap: .35rem; font-weight: 600; }
  .delivery-only { display: grid; gap: 1rem; }
  .delivery-only[hidden] { display: none; }
  .postcode { max-width: 12rem; }
  .hint { font-weight: 400; font-size: .85rem; }
  input:not([type]), input[type="tel"], input[type="email"], textarea {
    width: 100%; font: 1rem var(--font); color: var(--darkred); background: var(--white); border: 2px solid transparent; border-radius: .75rem; padding: .7rem .85rem;
  }
  input:focus-visible, textarea:focus-visible, .stepper button:focus-visible, .send:focus-visible, .method:has(input:focus-visible) { outline: 3px solid var(--darkred); outline-offset: 2px; }
