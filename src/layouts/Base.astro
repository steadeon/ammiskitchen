---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../lib/cms';
import { BETA_COOKIE, FEATURE_KEYS } from '../lib/features';
const site = await getSite();

interface Props {
  title?: string;
  description?: string;
  bg?: 'white' | 'yellow' | 'red' | 'none';
  home?: boolean;
  /** Keep this page out of search engines. */
  noindex?: boolean;
}
const { title, description = site.description, bg = 'yellow', home = false, noindex = false } = Astro.props;
const slide = {
  old: { name: 'slideOut', duration: '0.35s', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'slideIn', duration: '0.7s', easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fillMode: 'both' },
};
const pageAnim = { forwards: slide, backwards: slide };
const fullTitle = title ? `${title} — ${site.name}` : site.name;
---
<!doctype html>
<html lang="en-GB" data-bg={bg}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fe9907" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    <!-- Beta features this visitor has turned on (see src/lib/features.ts). Runs before the page
         is drawn, so hidden features never flash up. ?beta=on / ?beta=off on any address sets it. -->
    <script is:inline define:vars={{ cookieName: BETA_COOKIE, known: FEATURE_KEYS }}>
      if (!window.akBeta) {
        const read = () => {
          const m = document.cookie.match(new RegExp('(?:^|;\\s*)' + cookieName + '=([^;]*)'));
          return m ? decodeURIComponent(m[1]).split(',').filter((f) => known.includes(f)) : [];
        };
        const apply = () => {
          const on = read();
          if (on.length) document.documentElement.dataset.beta = on.join(' ');
          else delete document.documentElement.dataset.beta;
        };
        const write = (list) => {
          const on = [...new Set(list)].filter((f) => known.includes(f));
          document.cookie = cookieName + '=' + encodeURIComponent(on.join(',')) + '; path=/; SameSite=Lax; max-age=' +
            (on.length ? 31536000 : 0) + (location.protocol === 'https:' ? '; Secure' : '');
          apply();
        };
        window.akBeta = { known, read, write, apply };
        const url = new URL(location.href);
        const param = url.searchParams.get('beta');
        if (param !== null) {
          write(['off', '0', 'false', ''].includes(param) ? [] : ['on', '1', 'true'].includes(param) ? known : param.split(','));
          url.searchParams.delete('beta');
          history.replaceState(history.state, '', url);
        }
        // Moving between pages replaces the <html> attributes, so put the setting back each time.
        document.addEventListener('astro:after-swap', apply);
      }
      window.akBeta.apply();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Background />
    {!home && <Header />}
    <main transition:animate={pageAnim}>
      <slot />
    </main>
    <Footer />
    <a class="beta-badge" href="/beta/" data-astro-reload>Beta features on</a>

    <script>
      import lottie from 'lottie-web/build/player/lottie_light';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      function initLottie() {
        document.querySelectorAll<HTMLElement>('[data-lottie]:not([data-ready])').forEach((el) => {
          el.dataset.ready = '1';
          const anim = lottie.loadAnimation({
            container: el, renderer: 'svg', loop: false, autoplay: !reduce, path: el.dataset.lottie!,
            rendererSettings: { preserveAspectRatio: 'xMidYMid meet' },
          });
          if (reduce) anim.addEventListener('DOMLoaded', () => anim.goToAndStop(anim.totalFrames - 1, true));
          // Replay the draw-on when the logo is hovered.
          el.closest('a')?.addEventListener('mouseenter', () => !reduce && anim.goToAndPlay(0, true));
        });
      }

      function initReveal() {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }, { threshold: 0.12 });
        document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach((el) => io.observe(el));
      }

      document.addEventListener('astro:page-load', () => { initLottie(); initReveal(); });
    </script>
    <style is:global>
      @keyframes slideOut { to { opacity: 0; transform: translateY(-1.5rem); } }
      @keyframes slideIn { from { opacity: 0; transform: translateY(3rem); } }
    </style>
  </body>
</html>
