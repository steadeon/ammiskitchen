---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sticker from '../components/Sticker.astro';
import MenuCard from '../components/MenuCard.astro';
import { getOrder, getSite } from '../lib/cms';

const [order, site] = await Promise.all([getOrder(), getSite()]);
const current = await getEntry('menus', order.currentMenu);
if (!current) throw new Error(`Current menu "${order.currentMenu}" has no matching set meal`);
const past = (await getCollection('menus')).filter((m) => m.id !== order.currentMenu).sort((a, b) => a.data.order - b.data.order);

const d = new Date(order.orderBefore);
const tz = { timeZone: 'Europe/London' } as const;
const chips = [
  d.toLocaleDateString('en-GB', { ...tz, day: 'numeric' }),
  d.toLocaleDateString('en-GB', { ...tz, month: 'short' }),
  '‘' + d.toLocaleDateString('en-GB', { ...tz, year: '2-digit' }),
];
const time = d.toLocaleTimeString('en-GB', { ...tz, hour: 'numeric', minute: '2-digit', hour12: true }).toUpperCase();
const emailOrder = `mailto:${site.email}?subject=${encodeURIComponent('Takeaway order')}`;
---
<Base title="Order Takeaway" bg="red">
  <div class="container">
    <div class="intro">
      <Sticker kind="takeaway" size="14rem" heading />
      <div class="deadline" data-reveal>
        <p class="eyebrow">Order before</p>
        <p class="chips">{chips.map((c) => <span>{c}</span>)}<span class="time">{time}</span></p>
        <a class="small-link" href={site.mailchimp} target="_blank" rel="noopener">Sign up for takeaway reminders</a>
      </div>
    </div>

    <section class="section">
      <MenuCard menu={current.data} />
    </section>

    <section class="section options">
      <h2 class="visually-hidden">Choose how to get your meal</h2>
      {order.options.map((o) => (
        <a class="option" href={o.url} target="_blank" rel="noopener" data-reveal>
          <h3>{o.type}</h3>
          <p class="price">£{o.price.toFixed(2)}</p>
          <p>{o.description}</p>
          <span class="pay">Pay with PayPal →</span>
        </a>
      ))}
      <p class="email-order"><a class="pill-btn" href={emailOrder}>Or click here to order by email and pay cash/card on collection</a></p>
    </section>

    <section class="section split">
      <div class="card bg-yellow about-food" data-reveal set:html={site.aboutFood} />
      <div class="chef" data-reveal>
        {order.featuredChef.photo && <img src={order.featuredChef.photo} alt={order.featuredChef.name} width="120" height="120" loading="lazy" />}
        <p class="eyebrow">Meet the chef<br />{order.featuredChef.name}</p>
        <p>{order.featuredChef.description}</p>
      </div>
    </section>

    <section class="section voucher" data-reveal>
      <span class="shadow" aria-hidden="true"></span>
      <div class="card bg-pink voucher-card">
        <img src={site.giftVoucher.image} alt="" width="400" height="400" loading="lazy" />
        <div>
          <h2>{site.giftVoucher.title}</h2>
          <p><em>{site.giftVoucher.text}</em></p>
          <a class="pill-btn" href={site.giftVoucher.url} target="_blank" rel="noopener">{site.giftVoucher.buttonText}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="past-heading">Past menus</h2>
      <div class="past">
        {past.map((m) => (
          <a class="past-item" href={`/menu/${m.id}`} data-reveal>
            <img src={m.data.image} alt="" loading="lazy" width="800" height="600" />
            <p class="eyebrow">{m.data.title}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
<style>
  .intro { display: grid; gap: 2rem; justify-items: center; padding-top: 2rem; }
  .intro :global(.arc text) { fill: var(--white); }
  .intro :global(.burst path) { fill: var(--orange); }
  .chips { display: flex; gap: .4rem; margin: .4rem 0 .6rem; }
  .chips span { background: var(--white); border-radius: .4rem; padding: .2rem .6rem; font-size: 1.6rem; font-weight: 600; }
  .chips .time { background: var(--darkred); color: var(--white); }
  .small-link { font-size: .75rem; font-weight: 600; border: 1px solid; border-radius: .4rem; padding: .2rem .5rem; text-decoration: none; }
  .section { margin-top: 5rem; }
  .options { display: grid; gap: 1rem; }
  @media (min-width: 768px) { .options { grid-template-columns: repeat(3, 1fr); } .email-order { grid-column: 1 / -1; } }
  .option { display: flex; flex-direction: column; gap: .5rem; background: var(--orange); color: var(--white); border-radius: var(--radius); padding: 1.5rem; text-decoration: none; transition: transform .4s var(--ease-out); }
  .option:hover { transform: translateY(-6px) rotate(-1deg); }
  .option:nth-child(3):hover { transform: translateY(-6px) rotate(1deg); }
  .option h3 { font-size: 1.8rem; font-weight: 500; }
  .option .price { font-size: 2rem; margin: 0; }
  .option p { margin: 0; font-size: .9rem; }
  .option .pay { margin-top: auto; padding-top: 1rem; font-weight: 700; }
  .email-order { text-align: center; }
  .split { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 900px) { .split { grid-template-columns: 3fr 2fr; } }
  .about-food { font-size: clamp(1.1rem, 1.8vw, 1.4rem); font-weight: 500; line-height: 1.25; }
  .chef { border: 2px dashed var(--darkred); padding: 1.5rem; text-align: center; font-size: .9rem; }
  .chef img { width: 6rem; height: 6rem; border-radius: 50%; object-fit: cover; margin: 0 auto 1rem; }
  .voucher { position: relative; max-width: 44rem; margin-inline: auto; }
  .voucher .shadow { position: absolute; inset: 0; background: var(--orange); border-radius: var(--radius); transform: rotate(3deg) translate(1rem, .5rem); }
  .voucher-card { position: relative; display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 640px) { .voucher-card { grid-template-columns: 1fr 1.2fr; } }
  .voucher-card img { border-radius: 1rem; }
  .voucher-card h2 { color: var(--red); font-size: 1.6rem; margin-bottom: .5rem; }
  .past-heading { font-size: 2rem; margin-bottom: 1.5rem; }
  .past { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .past-item { text-decoration: none; background: var(--red); color: var(--brightyellow); transition: transform .4s var(--ease-out); }
  .past-item:hover { transform: rotate(-1.5deg) scale(1.02); }
  .past-item img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .past-item p { padding: .8rem 1rem; margin: 0; line-height: 1.4; }
</style>
