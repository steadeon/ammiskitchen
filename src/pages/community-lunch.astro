---
import Base from '../layouts/Base.astro';
import Sticker from '../components/Sticker.astro';
import { getCommunityLunch, getSettings } from '../lib/content';
const lunch = await getCommunityLunch();
const site = await getSettings();
const fmt = (s: string) => new Date(s + 'T12:00:00Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' });
---
<Base title="Community Lunch" bg="white">
  <div class="container narrow">
    <div class="title"><Sticker kind="lunch" size="16rem" tilt={-16} heading /></div>
    <p class="tagline" data-reveal>{lunch.tagline}</p>
    <div class="card bg-yellow intro" data-reveal set:html={lunch.introduction} />
    <section class="dates" data-reveal>
      <img class="burst spin-slow" src="/burst-red.svg" alt="" aria-hidden="true" />
      <div class="card bg-pink">
        <h2>{lunch.datesHeading}</h2>
        <ul>
          {lunch.dates.map((d) => <li data-date={d}>{fmt(d)} · 12–2pm</li>)}
        </ul>
        <p class="where"><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`} target="_blank" rel="noopener">{site.address}</a></p>
      </div>
    </section>
  </div>
</Base>
<script>
  // Hide dates that have already passed, so the list stays right between site rebuilds.
  document.addEventListener('astro:page-load', () => {
    const today = new Date().toISOString().slice(0, 10);
    document.querySelectorAll<HTMLElement>('[data-date]').forEach((li) => { if (li.dataset.date! < today) li.hidden = true; });
  });
</script>
<style>
  .narrow { max-width: 56rem; }
  .title { display: flex; justify-content: center; padding: 3rem 0 4rem; }
  .tagline { font-size: clamp(1.4rem, 3vw, 2.2rem); font-weight: 500; letter-spacing: -0.025em; line-height: 1.15; max-width: 36rem; margin: 0 0 3rem auto; }
  .intro { font-size: clamp(1.05rem, 1.6vw, 1.3rem); font-weight: 500; }
  .dates { position: relative; margin-top: 5rem; max-width: 30rem; }
  .dates .burst { position: absolute; width: 18rem; left: -7rem; top: -6rem; z-index: -1; }
  .dates h2 { font-size: 1.6rem; }
  .dates ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .4rem; font-size: 1.1rem; font-weight: 500; }
  .where { font-size: .9rem; }
</style>
