---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MenuCard from '../../components/MenuCard.astro';

export async function getStaticPaths() {
  return (await getCollection('menus')).map((m) => ({ params: { slug: m.id }, props: { menu: m.data } }));
}
const { menu } = Astro.props;
---
<Base title={menu.title} bg="red">
  <div class="container">
    <h1 class="banner" data-reveal>{menu.title}</h1>
    <MenuCard menu={menu} showTitle={false} />
    {!menu.ingredients && <p class="note">Full ingredients for this menu are available on request. Please tell us about any allergies when you order.</p>}
    <p class="back"><a class="pill-btn" href="/order">← Back to this week's menu</a></p>
  </div>
</Base>
<style>
  .banner { display: block; width: fit-content; max-width: 46rem; margin: 3rem auto 4rem; padding: 1rem 2.5rem; background: var(--darkred); color: var(--pink); text-align: center; font-size: clamp(1.6rem, 4vw, 2.6rem); transform: rotate(-4deg); }
  .banner.is-visible { transform: rotate(-4deg); }
  .note { margin-top: 2rem; font-weight: 600; }
  .back { margin-top: 3rem; text-align: center; }
</style>
